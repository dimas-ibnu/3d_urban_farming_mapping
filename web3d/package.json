  },
  "dependencies": {
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/three": "^0.182.0",
    "eslint": "^9.38.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
